{
  // GitHub Codespaces / Dev Containers setup for ZINU: Node 22 + pnpm + Docker (for Postgres/PostGIS, Redis and
  // S3-compatible storage). Nothing needs to be installed on your own computer.
  "name": "ZINU",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  // The phone reaches the app through the Cloudflare tunnel started by `pnpm phone`, so no port has to be public.
  // Forwarded ports stay private (GitHub sign-in required); the API, storage, Postgres and Redis are not forwarded.
  "forwardPorts": [3001],
  "portsAttributes": {
    "3001": { "label": "Admin dashboard", "onAutoForward": "notify" },
    "8081": { "label": "Expo (Metro)", "onAutoForward": "silent" },
    "4000": { "label": "ZINU API", "onAutoForward": "ignore" },
    "9000": { "label": "File storage (S3)", "onAutoForward": "ignore" },
    "8090": { "label": "Phone preview gateway", "onAutoForward": "ignore" },
    "5432": { "onAutoForward": "ignore" },
    "6379": { "onAutoForward": "ignore" }
  },
  "postCreateCommand": "bash scripts/codespace/setup.sh",
  "customizations": {
    "codespaces": { "openFiles": ["docs/IPHONE_PREVIEW.md"] }
  }
}

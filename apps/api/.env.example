# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://zinu:zinu@localhost:5432/zinu
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0001
ADMIN_JWT_SECRET=dev-only-change-me-dev-only-change-me-0002
OTP_HMAC_SECRET=dev-only-change-me-dev-only-change-me-0003
STAFF_TOTP_ENC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# OTP: "console" prints codes to the API log (development). Switch to "msg91" once DLT registration is done.
OTP_PROVIDER=console
# Development only: returns the OTP in the API response so the app can show it. Forced off in production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Browser origins allowed to call the API directly (the admin uses a same-origin proxy; 8081 = Expo web preview).
CORS_ORIGINS=http://localhost:3001,http://localhost:8081

# Set to true behind a load balancer (AWS ALB) so rate limits and audit logs see the real client IP.
TRUST_PROXY=false

# File storage. Local development uses RustFS (S3-compatible) from infra/docker-compose.yml.
S3_BUCKET=zinu-dev
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
# Phones must reach uploads too: set to http://<your computer's LAN IP>:9000 when testing on a device.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=zinu-dev
S3_SECRET_ACCESS_KEY=zinu-dev-secret
S3_AUTO_CREATE_BUCKET=true

# Encrypts bank/UPI payout details at rest. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYOUT_ENC_KEY=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100

# Push: "console" logs notifications (development). "expo" sends through Expo Push (needs an EAS project).
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=

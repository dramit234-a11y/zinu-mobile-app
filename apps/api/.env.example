# Copy to .env for local development. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://zinu:zinu@localhost:5432/zinu
REDIS_URL=redis://localhost:6379

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-0001
ADMIN_JWT_SECRET=dev-only-change-me-dev-only-change-me-0002
OTP_HMAC_SECRET=dev-only-change-me-dev-only-change-me-0003
STAFF_TOTP_ENC_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# OTP: "console" prints codes to the API log (development). Switch to "msg91" once DLT registration is done.
OTP_PROVIDER=console
# Development only: returns the OTP in the API response so the app can show it. Forced off in production.
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

CORS_ORIGINS=http://localhost:3001,http://localhost:8081

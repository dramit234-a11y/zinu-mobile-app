{
  "name": "@zinu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/db/migrate.js",
    "db:seed": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/seed.js",
    "staff:create": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/scripts/create-staff.js",
    "test": "tsc -p tsconfig.json && node --env-file-if-exists=.env.test --test --test-concurrency=1 'dist-test/test/**/*.test.js'"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@zinu/shared": "workspace:*",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}

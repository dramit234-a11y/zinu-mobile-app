# Public config only — everything prefixed EXPO_PUBLIC_ is bundled into the app.
# Testing on a real phone with Expo Go: use your computer's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Restricted Google Maps SDK keys used at build time (EAS secrets in CI). Not needed for Expo Go.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
